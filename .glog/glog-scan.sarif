        {
          "ruleId": "glog-e3a58974-60bd-4327-b45c-a4a29c5e36cc",
          "kind": "fail",
          "level": "error",
          "message": {
            "text": "\"Detected Use of Prohibited C Function (strncat)\""
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "runtime/hsa-runtime/core/runtime/amd_aie_agent.cpp"
                },
                "region": {
                  "startLine": 235,
                  "startColumn": 9,
                  "endLine": 236,
                  "endColumn": 43,
                  "charOffset": 8857,
                  "charLength": 112,
                  "snippet": {
                    "text": "strncat(reinterpret_cast<char *>(value), product_name_info_.c_str(),\n                 product_name_info_.size())",
                    "rendered": {
                      "text": "strncat(reinterpret_cast<char *>(value), product_name_info_.c_str(),\n                 product_name_info_.size())",
                      "markdown": "`strncat(reinterpret_cast<char *>(value), product_name_info_.c_str(),\n                 product_name_info_.size())`"
                    }
                  },
                  "sourceLanguage": "cpp"
                }
              }
            }
          ],
          "fixes": [
            {
              "description": {
                "text": "strncat adds the null terminator at character 'n + 1', rather than at the nth character. this frequently leads to the null terminator being added in the memory adjacent to the destination buffer, rather than in the destination buffer."
              },
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "runtime/hsa-runtime/core/runtime/amd_aie_agent.cpp"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "charOffset": 8857,
                        "charLength": 112
                      },
                      "insertedContent": {
                        "text": "strcat_s(reinterpret_cast<char *>(value), \n                 product_name_info_.size(,  product_name_info_.c_str())"
                      }
                    }
                  ]
                }
              ]
